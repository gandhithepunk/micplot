# Copy to .env and fill in.

# Crew login password. Leave blank for no crew auth (fine on a trusted network).
APP_PASSWORD=

# Admin panel PIN (4-6 digits). Leave blank for open admin access.
ADMIN_PIN=

# Shared secret for machine clients (e.g. a Companion module) that can't log
# in interactively. Leave blank to not offer this auth path.
API_TOKEN=

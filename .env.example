# Copy to .env and fill in. Leave APP_PASSWORD blank to run with no login
# (fine on a trusted local/venue network).
APP_PASSWORD=

# 4-6 digit PIN that gates the admin panel.
# Leave blank to run with admin open (local dev / trusted network only).
ADMIN_PIN=

# Shared secret for machine clients (e.g. a Bitfocus Companion module) that
# can't do the interactive password login -- send as `Authorization: Bearer
# <token>` on every request. Grants the same access as APP_PASSWORD. Only
# matters if APP_PASSWORD is set; leave blank to not offer this auth path.
API_TOKEN=
